# Copy to .env and change every secret before any shared deployment.
POSTGRES_USER=confluence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=confluence
DATABASE_URL=postgresql://confluence:change-me@timescaledb:5432/confluence
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_RAW_TOPIC=meter-readings-raw
KAFKA_ALERT_TOPIC=anomaly-alerts
REPLAY_SPEED=600          # 600x real time = one 15-minute interval every 1.5 s
DATA_MODE=auto            # auto | demo | database
API_KEY=change-me-too     # required for POST /thresholds and /alerts/{id}/ack
LOG_FORMAT=json
SEED=42
BACKUP_KEEP=7
